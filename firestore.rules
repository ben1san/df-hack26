rules_version = '2';

// ブラウザは Firestore を直接触らない。触るのは Cloud Run のプロセスだけで、
// 認証は サービスアカウント（ADC）。Admin SDK は rules を迂回するので、
// クライアント経路は全部閉じてよい。APIキーは1本も存在しない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
